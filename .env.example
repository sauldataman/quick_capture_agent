# Claude API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Default model settings
DEFAULT_MODEL=claude-sonnet-4-5-20241022
ORCHESTRATOR_MODEL=claude-opus-4-5-20250514

# Knowledge base settings
KNOWLEDGE_BASE_PATH=./data/knowledge

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=  # Comma-separated user IDs (empty = allow all)

# Optional: External services
OPENAI_API_KEY=your_openai_key_for_whisper  # Optional, for cloud whisper
